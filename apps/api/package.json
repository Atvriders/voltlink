{
  "name": "@voltlink/api",
  "version": "1.0.0",
  "private": true,
  "description": "VoltLink API — Express 5, PostgreSQL/Prisma, cookie auth, provider adapters, telemetry, commands, automations, fleet, status, SSE.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node build.mjs",
    "start": "node dist/index.cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "migrate:leader": "node dist/cli/migrateLeader.cjs"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@voltlink/shared": "*",
    "argon2": "^0.45.0",
    "bullmq": "^6.5.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^17.3.1",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.1.4",
    "otplib": "^13.5.0",
    "pg": "^8.16.0",
    "prisma": "^6.0.0",
    "undici": "^7.16.0",
    "web-push": "^3.6.7",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^7.0.0",
    "@types/pg": "^8.11.0",
    "@types/supertest": "^7.0.0",
    "@types/web-push": "^3.6.4",
    "supertest": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.4.5",
    "vitest": "^4.1.10"
  }
}
