generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Accounts and authentication
// ---------------------------------------------------------------------------

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  name                   String
  passwordHash           String
  emailVerifiedAt        DateTime? @db.Timestamptz(3)
  totpEnabled            Boolean   @default(false)
  totpSecretSealed       String?   // envelope v2, AAD totp:<id>
  totpPendingSealed      String?
  totpPendingExpiresAt   DateTime? @db.Timestamptz(3)
  totpLastStep           BigInt?
  totpEnabledAt          DateTime? @db.Timestamptz(3)
  webauthnUserId         String?   @unique
  isInstanceAdmin        Boolean   @default(false)
  suspendedAt            DateTime? @db.Timestamptz(3)
  lockedAt               DateTime? @db.Timestamptz(3)
  deletionRequestedAt    DateTime? @db.Timestamptz(3)
  timezone               String    @default("UTC")
  units                  String    @default("metric")
  locale                 String    @default("en-US")
  theme                  String    @default("voltlink-dark")
  demoEnabled            Boolean   @default(false)
  presentationMode       Boolean   @default(false)
  createdAt              DateTime  @db.Timestamptz(3) @default(now())
  sessions               UserSession[]
  verifications          EmailVerification[]
  passwordResets         PasswordReset[]
  passkeys               PasskeyCredential[]
  memberships            Membership[]
  vehicleGrants          VehicleGrant[]
  recoveryCodes          RecoveryCode[]
  notifications          AppNotification[]
  preferences            NotificationPreference[]
  automations            Automation[]
  apiKeys                ApiKey[]
  webhooks               WebhookEndpoint[]
  pushSubs               PushSubscription[]
  notificationChannels   NotificationChannel[]
  notificationOutbox   NotificationOutbox[]
  inboundWebhooks        InboundWebhook[]
  auditEvents            AuditLog[]
}

model UserSession {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash    String    @unique
  ip           String?
  userAgent    String?
  label        String?
  stepUpAt     DateTime? @db.Timestamptz(3)
  stepUpMethod String?
  createdAt    DateTime  @db.Timestamptz(3) @default(now())
  lastSeenAt   DateTime? @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  @@index([userId])
}

model EmailVerification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  @@index([userId])
}

model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  @@index([userId])
}

model PasskeyCredential {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String
  counter      BigInt
  transports   Json     @default("[]")
  name         String
  deviceType   String?
  backedUp     Boolean  @default(false)
  lastUsedAt   DateTime? @db.Timestamptz(3)
  createdAt    DateTime @db.Timestamptz(3) @default(now())
  @@index([userId])
}

model AuthChallenge {
  id         String    @id @default(cuid())
  handleHash String    @unique
  purpose    String
  userId     String?
  sessionId  String?
  challenge  String?
  attempts   Int       @default(0)
  expiresAt  DateTime  @db.Timestamptz(3)
  consumedAt DateTime? @db.Timestamptz(3)
  @@index([expiresAt])
}

model AuthThrottle {
  key         String    @id
  failures    Int       @default(0)
  lockedUntil DateTime? @db.Timestamptz(3)
  updatedAt   DateTime  @db.Timestamptz(3) @updatedAt
}

model RecoveryCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String
  usedAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime @db.Timestamptz(3) @default(now())
  @@unique([userId, codeHash])
}

model AuditLog {
  id             String    @id @default(cuid())
  actorId        String?
  actor          User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)
  organizationId String?
  actorKind      String    @default("user")
  apiKeyId       String?
  action         String
  entityType     String?
  entityId       String?
  details        Json?
  ip             String?
  requestId      String?
  createdAt      DateTime  @db.Timestamptz(3) @default(now())
  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([organizationId, createdAt])
}

// ---------------------------------------------------------------------------
// Organizations and tenancy
// ---------------------------------------------------------------------------

enum OrgKind {
  PERSONAL
  TEAM
  OPERATOR
}

enum OrgRole {
  OWNER
  ADMIN
  FLEET_MANAGER
  DRIVER
  VIEWER
  STATUS_MANAGER
  SUPPORT
}

enum AccessScope {
  ALL
  GRANTED
}

enum GrantLevel {
  VIEWER
  DRIVER
  MANAGER
}

model Organization {
  id                       String         @id @default(cuid())
  kind                     OrgKind        @default(PERSONAL)
  name                     String
  telemetryRetentionDays   Int?
  locationRetentionDays    Int?
  timezone                 String         @default("UTC")
  demoDegraded             Boolean        @default(false)
  createdById              String?
  createdAt                DateTime       @db.Timestamptz(3) @default(now())
  memberships              Membership[]
  invitations              Invitation[]
  vehicles                 Vehicle[]
  providerAccounts         ProviderAccount[]
  apiKeys                  ApiKey[]
  places                   Place[]
  geofences                Geofence[]
  privacyZones             PrivacyZone[]
  rateRules                RateRule[]
  automations              Automation[]
  fleetGroups              FleetGroup[]
  departments              Department[]
  costCenters              CostCenter[]
  drivers                  Driver[]
  vehicleAssignments       VehicleAssignment[]
}

model Membership {
  id             String                @id @default(cuid())
  organizationId String
  organization   Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           OrgRole
  vehicleScope   AccessScope           @default(ALL)
  providerScope  AccessScope           @default(ALL)
  status         String                @default("ACTIVE")
  invitedById    String?
  createdAt      DateTime              @db.Timestamptz(3) @default(now())
  providerGrants ProviderAccountGrant[]
  @@unique([organizationId, userId])
  @@index([userId])
}

model VehicleGrant {
  id            String    @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  level         GrantLevel @default(VIEWER)
  allowHighRisk Boolean   @default(false)
  grantedById   String?
  expiresAt     DateTime? @db.Timestamptz(3)
  createdAt     DateTime  @db.Timestamptz(3) @default(now())
  @@unique([vehicleId, userId])
  @@index([userId])
}

model Invitation {
  id               String     @id @default(cuid())
  organizationId   String
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  kind             String
  email            String
  role             OrgRole?
  vehicleId        String?
  grantLevel       GrantLevel?
  allowHighRisk    Boolean    @default(false)
  tokenHash        String    @unique
  invitedById      String
  deliveredByEmail Boolean    @default(false)
  expiresAt        DateTime  @db.Timestamptz(3)
  acceptedAt       DateTime? @db.Timestamptz(3)
  revokedAt        DateTime? @db.Timestamptz(3)
  createdAt        DateTime  @db.Timestamptz(3) @default(now())
  @@index([organizationId])
}

model ProviderAccountGrant {
  id                String          @id @default(cuid())
  membershipId      String
  membership        Membership      @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  providerAccountId String
  providerAccount   ProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)
  canCommand        Boolean         @default(true)
  canManage         Boolean         @default(false)
  @@unique([membershipId, providerAccountId])
}

model OAuthState {
  stateHash          String   @id
  provider           String
  userId             String
  sessionId          String
  organizationId     String
  verifierSealed     String
  reconnectAccountId String?
  expiresAt          DateTime @db.Timestamptz(3)
  createdAt          DateTime @default(now()) @db.Timestamptz(3)
  @@index([expiresAt])
}

model CommandIdempotency {
  scope       String
  key         String
  requestHash String
  commandId   String
  expiresAt   DateTime @db.Timestamptz(3)
  @@id([scope, key])
  @@index([expiresAt])
}

model DataTask {
  name      String   @id
  appliedAt DateTime @db.Timestamptz(3) @default(now())
}

// ---------------------------------------------------------------------------
// Providers
// ---------------------------------------------------------------------------

model ProviderAccount {
  id              String                @id @default(cuid())
  organizationId  String
  organization    Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connectedById   String?
  provider        String
  label           String
  status          String                @default("pending")
  demo            Boolean               @default(false)
  scopes          Json                  @default("[]")
  commandsEnabled Boolean               @default(true)
  lastSyncAt      DateTime? @db.Timestamptz(3)
  lastError       String?
  createdAt       DateTime  @db.Timestamptz(3) @default(now())
  credential      ProviderCredential?
  vehicles        Vehicle[]
  grants          ProviderAccountGrant[]
  @@index([organizationId])
}

model ProviderCredential {
  id                String          @id @default(cuid())
  providerAccountId String          @unique
  providerAccount   ProviderAccount @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)
  keyVersion        Int
  algorithm         String
  ciphertext        String
  createdAt         DateTime @db.Timestamptz(3)        @default(now())
}

// ---------------------------------------------------------------------------
// Vehicles and telemetry
// ---------------------------------------------------------------------------

model Vehicle {
  id                String           @id @default(cuid())
  organizationId    String
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  addedById         String?
  providerAccountId String
  providerAccount   ProviderAccount  @relation(fields: [providerAccountId], references: [id], onDelete: Cascade)
  provider          String
  providerVehicleId String
  displayName       String
  make              String?
  model             String?
  year              Int?
  vehicleClass      String           @default("fallback")
  exteriorColor     String           @default("#8b9bb4")
  wheelStyle        String?
  vinLast4          String?
  capabilities      Json             @default("[]")
  demo              Boolean          @default(false)
  active            Boolean          @default(true)
  createdAt         DateTime @db.Timestamptz(3)         @default(now())
  updatedAt         DateTime @db.Timestamptz(3)         @updatedAt
  snapshot          VehicleSnapshot?
  pollState         VehiclePollState?
  locations         VehicleLocation?
  drives            Drive[]
  chargeSessions    ChargingSession[]
  commands          VehicleCommand[]
  assignments       VehicleAssignment[]
  grants            VehicleGrant[]
  maintenance       MaintenanceRecord[]
  groupLinks        FleetGroupVehicle[]
  aggregatesDaily   AggregateDaily[]
  aggregatesMonthly AggregateMonthly[]
  @@unique([provider, providerVehicleId, providerAccountId])
  @@index([organizationId])
}

model VehicleSnapshot {
  vehicleId String    @id
  vehicle   Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  state     Json
  fetchedAt DateTime @db.Timestamptz(3)
  freshness String    @default("last_known")
  updatedAt DateTime @db.Timestamptz(3)  @updatedAt
}

model VehicleLocation {
  vehicleId     String    @id
  vehicle       Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  ts            DateTime  @db.Timestamptz(3)
  lat           Float?
  lon           Float?
  headingDeg    Float?
  speedKmh      Float?
  accuracyM     Float?
  address       String?
  privacyZoneId String?
}

// ---------------------------------------------------------------------------
// Places, geofences, privacy zones
// ---------------------------------------------------------------------------

model Place {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  name           String
  type           String  @default("custom")
  lat            Float
  lon            Float
  radiusM        Float   @default(100)
  @@index([organizationId])
}

model Geofence {
  id              String    @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById     String?
  name            String
  lat             Float
  lon             Float
  radiusM         Float     @default(200)
  alertOn         String    @default("both")
  enabled         Boolean   @default(true)
  lastTriggeredAt DateTime? @db.Timestamptz(3)
  @@index([organizationId])
}

model PrivacyZone {
  id              String  @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById     String?
  name            String
  lat             Float
  lon             Float
  radiusM         Float   @default(300)
  enabled         Boolean @default(true)
  createdAt       DateTime @db.Timestamptz(3) @default(now())
  redactedThrough DateTime? @db.Timestamptz(3)
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Drives and charging
// ---------------------------------------------------------------------------

model Drive {
  id                 String           @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle          @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startAt            DateTime @db.Timestamptz(3)
  endAt              DateTime @db.Timestamptz(3)
  startLat           Float?
  startLon           Float?
  startAddress       String?
  startPrivacyZoneId String?
  endLat             Float?
  endLon             Float?
  endAddress         String?
  endPrivacyZoneId   String?
  distanceKm         Float
  durationSec        Int
  avgSpeedKmh        Float
  maxSpeedKmh        Float
  energyKwh          Float
  efficiencyWhPerKm  Float
  estCost            Float?
  currency           String           @default("USD")
  elevationGainM     Float?
  avgOutsideTempC    Float?
  driverName         String?
  tags               Json             @default("[]")
  classification     String           @default("unknown")
  notes              String?
  routePoints        DriveRoutePoint[]
  @@index([vehicleId, startAt])
}

model DriveRoutePoint {
  id         String   @id @default(cuid())
  driveId    String
  drive      Drive    @relation(fields: [driveId], references: [id], onDelete: Cascade)
  seq        Int
  ts         DateTime @db.Timestamptz(3)
  lat        Float
  lon        Float
  speedKmh   Float
  headingDeg Float?
  batteryPct Float?
  @@index([driveId, seq])
}

model ChargingSession {
  id              String   @id @default(cuid())
  vehicleId       String
  vehicle         Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  startAt         DateTime @db.Timestamptz(3)
  endAt           DateTime? @db.Timestamptz(3)
  locationName    String?
  lat             Float?
  lon             Float?
  privacyZoneId   String?
  energyAddedKwh  Float    @default(0)
  batteryStartPct Float?
  batteryEndPct   Float?
  durationSec     Int      @default(0)
  avgPowerKw      Float    @default(0)
  peakPowerKw     Float    @default(0)
  cost            Float    @default(0)
  currency        String   @default("USD")
  source          String   @default("other")
  idleTimeSec     Int      @default(0)
  estLossKwh      Float    @default(0)
  notes           String?
  rateRuleId      String?
  rateName        String?
  pricePerKwh     Float?
  manualCost      Float?
  @@index([vehicleId, startAt])
}

model RateRule {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  name           String
  type           String  @default("flat")
  pricePerKwh    Float
  currency       String  @default("USD")
  periods        Json    @default("[]")
  placeId        String?
  enabled        Boolean @default(true)
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Automations and notifications
// ---------------------------------------------------------------------------

model Automation {
  id                  String               @id @default(cuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById         String?
  userId              String
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  description         String?
  enabled             Boolean              @default(true)
  vehicleId           String?
  triggerType         String
  triggerParams       Json                 @default("{}")
  conditions          Json                 @default("[]")
  actions             Json                 @default("[]")
  cooldownSec         Int                  @default(0)
  maxRetries          Int                  @default(1)
  highRiskApprovedAt  DateTime? @db.Timestamptz(3)
  approvedActionsHash String?
  lastRunAt           DateTime? @db.Timestamptz(3)
  lastResult          String?
  runCount            Int                  @default(0)
  failureCount        Int                  @default(0)
  createdAt           DateTime @db.Timestamptz(3)             @default(now())
  executions          AutomationExecution[]
  inboundWebhook      InboundWebhook?
  @@index([organizationId])
  @@index([userId])
}

model AutomationExecution {
  id            String     @id @default(cuid())
  automationId  String
  automation    Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  triggeredAt   DateTime @db.Timestamptz(3)   @default(now())
  triggerEvent  String?
  conditionsMet Boolean    @default(false)
  result        String     @default("skipped")
  actionResults Json       @default("[]")
  errorMessage  String?
  @@index([automationId, triggeredAt])
}

model AppNotification {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event       String
  severity    String   @default("info")
  title       String
  body        String
  vehicleId   String?
  vehicleName String?
  channel     String   @default("in_app")
  readAt      DateTime? @db.Timestamptz(3)
  createdAt   DateTime @db.Timestamptz(3) @default(now())
  @@index([userId, readAt, createdAt])
}

model NotificationPreference {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel  String
  event    String
  severity String @default("info")
  enabled  Boolean @default(true)
  @@unique([userId, channel, event, severity])
}

model WebhookEndpoint {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                  String
  url                   String
  displayHint           String?
  events                Json      @default("[]")
  secretSealed          String?
  previousSecretSealed  String?
  previousUntil         DateTime? @db.Timestamptz(3)
  enabled               Boolean   @default(true)
  lastStatus            Int?
  lastDeliveryAt        DateTime? @db.Timestamptz(3)
  @@index([userId])
}

model NotificationOutbox {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String
  event     String
  severity  String   @default("info")
  title     String
  body      String
  vehicleId String?
  status    String   @default("pending")
  attempts  Int      @default(0)
  nextRunAt DateTime @db.Timestamptz(3) @default(now())
  lastError String?
  sentAt    DateTime? @db.Timestamptz(3)
  deadAt    DateTime? @db.Timestamptz(3)
  createdAt DateTime @db.Timestamptz(3) @default(now())
  @@index([status, nextRunAt])
  @@index([userId, createdAt])
}

model NotificationChannel {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind                String
  name                String
  configCiphertext    String
  enabled             Boolean  @default(true)
  disabledReason      String?
  nextAllowedAt       DateTime? @db.Timestamptz(3)
  consecutiveFailures Int      @default(0)
  lastSuccessAt       DateTime? @db.Timestamptz(3)
  lastFailureAt       DateTime? @db.Timestamptz(3)
  lastFailureKind     String?
  createdAt           DateTime @db.Timestamptz(3) @default(now())
  updatedAt           DateTime @db.Timestamptz(3) @default(now())
  @@index([userId, kind])
}

model InboundWebhook {
  id             String    @id @default(cuid())
  automationId   String    @unique
  automation     Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  publicId       String    @unique
  secretSealed   String
  createdAt      DateTime  @db.Timestamptz(3) @default(now())
  lastReceivedAt DateTime? @db.Timestamptz(3)
  receipts       InboundWebhookReceipt[]
}

model InboundWebhookReceipt {
  id        String   @id @default(cuid())
  hookId    String
  hook      InboundWebhook @relation(fields: [hookId], references: [id], onDelete: Cascade)
  messageId String
  createdAt DateTime @db.Timestamptz(3) @default(now())
  @@unique([hookId, messageId])
  @@index([hookId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String
  keys      Json
  createdAt DateTime @db.Timestamptz(3) @default(now())
  @@unique([userId, endpoint])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Vehicle commands
// ---------------------------------------------------------------------------

model DriveTracker {
  vehicleId  String    @id
  startedAt  DateTime @db.Timestamptz(3)
  startedPct Float?
  maxSpeed   Float
  points     Json      @default("[]")
  lastMoving DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3) @updatedAt
}

model VehiclePollState {
  vehicleId         String    @id
  vehicle           Vehicle   @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  connectivity      String    @default("unknown")
  activity          Json?
  lastVehicleDataAt DateTime? @db.Timestamptz(3)
  lastActivityAt    DateTime? @db.Timestamptz(3)
  nextPollAt        DateTime  @db.Timestamptz(3) @default(now())
  nextAction        String    @default("vehicle_data")
  mode              String    @default("idle")
  pendingCommandUntil DateTime? @db.Timestamptz(3)
  userActiveUntil   DateTime? @db.Timestamptz(3)
  suspendedUntil    DateTime? @db.Timestamptz(3)
  backoffUntil      DateTime? @db.Timestamptz(3)
  updatedAt         DateTime  @db.Timestamptz(3) @updatedAt
}

model VehicleCommand {
  id                String             @id @default(cuid())
  vehicleId         String
  vehicle           Vehicle            @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  organizationId    String
  vehicleName       String             @default("")
  providerAccountId String
  userId            String
  actorKind         String             @default("user")
  apiKeyId          String?
  automationId      String?
  sourceIp          String?
  authzDecision     Json?
  type              String
  params            Json               @default("{}")
  status            String             @default("queued")
  risk              String             @default("low")
  idempotencyKey    String?
  confirmed         Boolean            @default(false)
  createdAt         DateTime @db.Timestamptz(3)           @default(now())
  submittedAt       DateTime? @db.Timestamptz(3)
  completedAt       DateTime? @db.Timestamptz(3)
  providerResponse  String?
  responseCategory  String?
  confirmation      String?
  errorMessage      String?
  auditEvents       CommandAuditEvent[]
  @@index([vehicleId, createdAt])
  @@index([userId, createdAt])
}

model CommandAuditEvent {
  id        String         @id @default(cuid())
  commandId String
  command   VehicleCommand @relation(fields: [commandId], references: [id], onDelete: Cascade)
  event     String
  actor     String
  detail    String
  createdAt DateTime @db.Timestamptz(3)       @default(now())
  @@index([commandId, createdAt])
}

model ApiKey {
  id             String    @id @default(cuid())
  userId         String
  user           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  keyHash        String    @unique
  prefix         String    @unique
  scopes         Json      @default("[]")
  lastUsedAt     DateTime? @db.Timestamptz(3)
  lastUsedIp     String?
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  createdAt      DateTime  @db.Timestamptz(3) @default(now())
  @@index([userId])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Status platform
// ---------------------------------------------------------------------------

model StatusComponent {
  id             String       @id @default(cuid())
  key            String       @unique
  name           String
  group          String
  description    String?
  status         String       @default("unknown")
  manualOverride Boolean      @default(false)
  updatedAt      DateTime @db.Timestamptz(3)     @updatedAt
  checks         StatusCheck[]
}

model StatusCheck {
  id           String          @id @default(cuid())
  componentKey String
  component    StatusComponent @relation(fields: [componentKey], references: [key], onDelete: Cascade)
  at           DateTime @db.Timestamptz(3)        @default(now())
  ok           Boolean
  latencyMs    Int?
  detail       String?
  @@index([componentKey, at])
}

model Incident {
  id          String           @id @default(cuid())
  title       String
  severity    String           @default("minor")
  status      String           @default("investigating")
  phases      Json             @default("{}")
  components  Json             @default("[]")
  public      Boolean          @default(true)
  createdById String?
  source      String           @default("manual")
  createdAt   DateTime @db.Timestamptz(3)         @default(now())
  updates     IncidentUpdate[]
}

model IncidentUpdate {
  id         String   @id @default(cuid())
  incidentId String
  incident   Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  phase      String
  message    String
  author     String
  createdAt  DateTime @db.Timestamptz(3) @default(now())
  @@index([incidentId, createdAt])
}

model MaintenanceWindow {
  id          String   @id @default(cuid())
  title       String
  description String?
  startsAt    DateTime @db.Timestamptz(3)
  endsAt      DateTime @db.Timestamptz(3)
  components  Json     @default("[]")
  status      String   @default("scheduled")
}

model StatusSubscription {
  id        String    @id @default(cuid())
  email     String    @unique
  token     String    @unique
  confirmed Boolean   @default(false)
  createdAt DateTime @db.Timestamptz(3)  @default(now())
}

// ---------------------------------------------------------------------------
// Fleet management
// ---------------------------------------------------------------------------

model FleetGroup {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  name           String
  description    String?
  vehicles       FleetGroupVehicle[]
  @@index([organizationId])
}

model FleetGroupVehicle {
  fleetGroupId String
  vehicleId    String
  fleetGroup   FleetGroup @relation(fields: [fleetGroupId], references: [id], onDelete: Cascade)
  vehicle      Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  @@id([fleetGroupId, vehicleId])
}

model Department {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  name           String
  @@index([organizationId])
}

model CostCenter {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  name           String
  code           String
  @@index([organizationId])
}

model Driver {
  id             String  @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String?
  userId         String?
  name           String
  email          String?
  phone          String?
  active         Boolean @default(true)
  @@index([organizationId])
}

model VehicleAssignment {
  id             String     @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vehicleId      String
  vehicle        Vehicle    @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  driverId       String
  departmentId   String?
  costCenterId   String?
  fromAt         DateTime? @db.Timestamptz(3)
  toAt           DateTime? @db.Timestamptz(3)
  @@index([vehicleId])
  @@index([organizationId])
}

model MaintenanceRecord {
  id            String   @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  title         String
  kind          String   @default("service")
  dueAt         DateTime? @db.Timestamptz(3)
  dueOdometerKm Float?
  completedAt   DateTime? @db.Timestamptz(3)
  cost          Float?
  currency      String   @default("USD")
  notes         String?
  @@index([vehicleId])
}

// ---------------------------------------------------------------------------
// Settings and aggregates
// ---------------------------------------------------------------------------

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @db.Timestamptz(3) @updatedAt
}

model AggregateDaily {
  id                 String   @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  date               DateTime @db.Date
  distanceKm         Float    @default(0)
  energyKwh          Float    @default(0)
  chargeEnergyKwh    Float    @default(0)
  chargeCost         Float    @default(0)
  driveCount         Int      @default(0)
  chargeSessionCount Int      @default(0)
  minBatteryPct      Float?
  maxBatteryPct      Float?
  @@unique([vehicleId, date])
  @@index([date])
}

model AggregateMonthly {
  id                 String   @id @default(cuid())
  vehicleId          String
  vehicle            Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  month              DateTime @db.Date
  distanceKm         Float    @default(0)
  energyKwh          Float    @default(0)
  chargeEnergyKwh    Float    @default(0)
  chargeCost         Float    @default(0)
  driveCount         Int      @default(0)
  chargeSessionCount Int      @default(0)
  @@unique([vehicleId, month])
}

// ---------------------------------------------------------------------------
// Background jobs (Postgres queue implementation)
// ---------------------------------------------------------------------------


model DataRetentionJob {
  id             String   @id @default(cuid())
  kind           String
  organizationId String?
  ranAt          DateTime @db.Timestamptz(3) @default(now())
  rowsDeleted    Int      @default(0)
  detail         String?
  @@index([kind, ranAt])
}
