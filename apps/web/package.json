{
  "name": "@voltlink/web",
  "version": "1.0.0",
  "private": true,
  "description": "VoltLink SPA \u2014 React 19 + Vite 7 + React Router 7 + Tailwind + TanStack Query + MapLibre + React Three Fiber.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "assets": "tsx ../../scripts/assets/postprocess.ts && tsx ../../scripts/assets/stage.ts",
    "prebuild": "npm run assets",
    "predev": "npm run assets"
  },
  "dependencies": {
    "@react-three/drei": "^10.6.0",
    "@react-three/fiber": "^9.2.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "^5.106.1",
    "@voltlink/shared": "*",
    "dompurify": "^3.4.17",
    "lucide-react": "^1.70.0",
    "maplibre-gl": "^6.16.0",
    "markdown-it": "^14.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.0",
    "recharts": "^2.12.6",
    "tailwindcss": "^4.1.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/geojson": "^7946.0.14",
    "@types/markdown-it": "^14.1.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^5.2.0",
    "jsdom": "^29.0.0",
    "typescript": "^5.4.5",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
