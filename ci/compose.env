# Fictional fixture environment for CI's config-only compose calls.
# `docker compose config` interpolates `${VAR:?message}` before anything else,
# so a config-only call needs values for every required variable. These are
# NOT secrets and NOT used by any deployment: they exist only so that parsing
# and rendering checks can run without a real .env.
POSTGRES_PASSWORD=fixture-not-a-real-database-password
JWT_SECRET=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
VL_MASTER_KEY=bm90LWEtcmVhbC1tYXN0ZXIta2V5LTAxMjM0NTY3ODk=
PUBLIC_URL=http://fixture.invalid:3110
# Required by docker-compose.tunnel.yml's `${VAR:?}` guard; a fixture, not a token.
CLOUDFLARE_TUNNEL_TOKEN=ci-not-a-real-tunnel-token
