{
  "name": "voltlink",
  "private": true,
  "version": "1.0.0",
  "description": "VoltLink \u2014 self-hosted connected-vehicle platform: vehicle telemetry, secure controls, drives, charging, battery analytics, automations, notifications, fleet management, and a full status platform.",
  "license": "MIT",
  "author": "Atvriders",
  "homepage": "https://github.com/Atvriders/voltlink#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Atvriders/voltlink.git"
  },
  "bugs": {
    "url": "https://github.com/Atvriders/voltlink/issues"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "overrides": {
    "vite": "^7.3.7",
    "@types/node": "^24.0.0",
    "@types/express": "^5.0.0",
    "deepmerge-ts": "^8.0.0"
  },
  "scripts": {
    "dev:api": "npm -w @voltlink/api run dev",
    "dev:web": "npm -w @voltlink/web run dev",
    "build": "npm run prisma:generate && npm -w @voltlink/shared run build && npm -w @voltlink/api run build && npm -w @voltlink/web run build && node scripts/stage-web-dist.mjs",
    "test": "vitest run",
    "typecheck": "npm -w @voltlink/shared run typecheck && npm -w @voltlink/api run typecheck && npm -w @voltlink/web run typecheck",
    "lint": "eslint . --max-warnings=0",
    "legacy:scan": "tsx scripts/legacy-scan.ts",
    "e2e": "playwright test",
    "naming:scan": "tsx scripts/naming-scan.ts",
    "prisma:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "check:compose": "tsx scripts/check-compose.ts",
    "check:bundle": "tsx scripts/check-bundle.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:unit": "vitest run --project shared --project api-unit --project web",
    "test:int": "vitest run --project api-int",
    "test:coverage": "vitest run --coverage --reporter=default --reporter=json --outputFile.json=test-results/vitest.json",
    "test:inventory": "tsx scripts/test-inventory.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.0",
    "@gltf-transform/cli": "^4.5.1",
    "@gltf-transform/core": "^4.5.1",
    "@gltf-transform/extensions": "^4.5.1",
    "@gltf-transform/functions": "^4.5.1",
    "@playwright/test": "^1.55.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "gltf-validator": "^2.0.0-dev.3.10",
    "meshoptimizer": "^1.3.0",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.72.1"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "argon2@0.45.0": true,
    "@prisma/client": true,
    "@prisma/engines": true,
    "esbuild": true
  }
}
