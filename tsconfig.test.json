{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx"
  },
  "include": [
    "tests/**/*.ts",
    "apps/api/test/**/*.ts",
    "scripts/**/*.ts",
    "scripts/**/*.mts",
    "scripts/**/*.cts",
    "playwright.config.ts",
    "vitest.config.mts",
    "apps/api/vitest.config.ts"
  ]
}
