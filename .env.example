# VoltLink configuration — copy to .env and fill in real values.
# Every variable here appears in ENV_SPEC (apps/api/src/core/env-spec.ts) and is
# passed to every role by both compose files; `npm run check:compose` proves it.

# --- Web ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
WEB_PORT=3110
STATUS_PORT=3001
PUBLIC_URL=https://voltlink.example.com
# Plain-HTTP LAN deployments: set PUBLIC_URL to the http:// URL and this to true
# (passkeys and web push stay unavailable without HTTPS).
VL_ALLOW_INSECURE_HTTP=false
# false (default), a hop count (e.g. 1 behind one proxy), or a comma list of
# proxy addresses/CIDRs (e.g. loopback,172.16.0.0/12). `true` refuses to start.
TRUST_PROXY=false
# Comma-separated extra origins allowed by the CSP connect-src/img-src
# (map tile/style/glyph hosts).
VL_CSP_CONNECT_ORIGINS=
LOG_LEVEL=info

# --- Database / queue ---
DATABASE_URL=postgresql://voltlink:voltlink@postgres:5432/voltlink
POSTGRES_PASSWORD=change-me-db-password
# Optional. The migration tests create throwaway databases and need a Postgres
# role with CREATEDB. When unset, tests derive this from DATABASE_URL by using
# the `postgres` maintenance database on the same server.
TEST_DATABASE_ADMIN_URL=postgresql://voltlink:voltlink@postgres:5432/postgres
REDIS_URL=redis://redis:6379

# --- Secrets (required in production; boot refuses placeholders) ---
# openssl rand -hex 32
JWT_SECRET=change-me-64-hex-characters
JWT_EXPIRES_SEC=1209600
# openssl rand -base64 32
VL_MASTER_KEY=change-me-base64-32-bytes
# Rotation history: comma-separated `vN:<base64 key>` entries.
VL_MASTER_KEYS=
# First-run setup: at least 32 chars; the first registration with this token
# becomes the instance admin. When unset the web role generates one and logs it.
VL_SETUP_TOKEN=

# --- Limits ---
VL_RATE_LIMIT_PER_MIN=900
VL_STEPUP_WINDOW_SEC=300

# --- Email (optional; console logging used when SMTP_URL is empty) ---
SMTP_URL=
MAIL_FROM=VoltLink <no-reply@voltlink.local>
MAIL_TO_CONSOLE=true

# --- WebAuthn / passkeys ---
VL_WEBAUTHN_RP_ID=voltlink.example.com
VL_WEBAUTHN_RP_NAME=VoltLink
VL_TOTP_ISSUER=VoltLink

# --- Providers ---
# Tesla official Fleet API (https://developer.tesla.com)
TESLA_CLIENT_ID=
TESLA_CLIENT_SECRET=
TESLA_REDIRECT_URI=https://voltlink.example.com/api/v1/providers/tesla/callback
TESLA_BASE_URL=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_TOKEN_URL=https://fleet-auth.prd.vn.cloud.tesla.com/oauth2/v3/token
TESLA_AUTHORIZE_URL=https://auth.tesla.com/oauth2/v3/authorize
TESLA_DEFAULT_AUDIENCE=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_FLEET_BASE_NA=https://fleet-api.prd.na.vn.cloud.tesla.com
TESLA_FLEET_BASE_EU=https://fleet-api.prd.eu.vn.cloud.tesla.com
TESLA_PARTNER_DOMAIN=
TESLA_PUBLIC_KEY_FILE=/run/voltlink/tesla/public-key.pem
TESLA_COMMAND_PROXY_URL=
TESLA_ALLOW_TEST_ENDPOINTS=false
TESLA_DAILY_BUDGET_USD=
# Optional Tessie provider
TESSIE_BASE_URL=https://api.tessie.com

# --- Web push (optional) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@voltlink.local
# Extra allowed push service hosts (comma-separated), e.g. a self-hosted gateway.
VL_PUSH_SERVICE_HOSTS=

# --- Behaviour ---
VL_DEMO_DEFAULT_ENABLED=false
# Owner-controlled LAN targets for outbound webhooks/notifications, e.g.
# `127.0.0.1/32:8080,10.0.0.0/24` (prefix < /8 and never-allowable ranges are rejected).
VL_OUTBOUND_ALLOW=
VL_DEV_ECHO_TOKENS=false

# --- Image tag for compose.production.yml ---
VOLTLINK_IMAGE_TAG=latest
